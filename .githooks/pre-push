#!/usr/bin/env bash
# pre-push — refuse to push commits that credit an AI co-author.
#
# Blocks any commit whose message contains a "Co-Authored-By:" line naming an
# AI assistant (Claude, Codex, GPT, Copilot, …). Only inspects the commits the
# push would actually add to the remote, so pre-existing history is untouched.
#
# Enable in this clone:  git config core.hooksPath .githooks
set -uo pipefail

zero="0000000000000000000000000000000000000000"
# Co-Authored-By line naming a known AI assistant / vendor.
pattern='co-authored-by:.*(claude|codex|gpt|copilot|anthropic|openai|gemini|bard|llama|mistral)'
fail=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                 # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    range=$(git rev-list "$local_sha" --not --remotes)   # new branch: only its unique commits
  else
    range=$(git rev-list "$remote_sha..$local_sha")
  fi
  [ -z "$range" ] && continue
  for sha in $range; do
    if git log -1 --format='%B' "$sha" | grep -qiE "$pattern"; then
      echo "pre-push: BLOCKED — commit credits an AI co-author:" >&2
      git log -1 --format='  %h %s' "$sha" >&2
      git log -1 --format='%B' "$sha" | grep -iE 'co-authored-by:' | sed 's/^/      /' >&2
      fail=1
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "Strip the Co-Authored-By trailer (git commit --amend / git rebase) and push again." >&2
  exit 1
fi
exit 0
